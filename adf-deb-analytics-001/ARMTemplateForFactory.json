{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-deb-analytics-001"
		},
		"ADLSGen2_LS_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ADLSGen2_LS'"
		},
		"AzureSql_LS_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzureSql_LS'"
		},
		"ADLSGen2_LS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://sadlshealth001.dfs.core.windows.net/"
		},
		"AzureSql_LS_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "debazureprojectserver.database.windows.net"
		},
		"AzureSql_LS_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "debazuredeb"
		},
		"AzureSql_LS_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "dikshit"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/incremental_ingestion')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
